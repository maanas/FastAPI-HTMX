# Copy to .env and edit. The values below work for local development over
# http on 127.0.0.1. Every secret here is a placeholder: replace it.

# Database. SQLite file in the project root, created by `alembic upgrade head`.
DATABASE_URL="sqlite+aiosqlite:///./users.db"

# Secret that signs the login token. Use a long random string.
# If it is missing the app falls back to a built-in default (not safe).
AUTH_SECRET="change-me-auth-secret"

# MinIO object storage (file uploads). Placeholders only record uploads in the
# database; files are stored only with a real MinIO server.
MINIO_URL="http://localhost:9000"
MINIO_ACCESS_KEY="change-me-minio-access-key"
MINIO_SECRET_KEY="change-me-minio-secret-key"
MINIO_BUCKET="my-fastapi-bucket"
# Production: true (HTTPS to the MinIO server).
MINIO_SECURE=false

# CSRF protection. Secret that signs the CSRF token.
CSRF_SECRET_KEY="change-me-csrf-secret"
# lax, strict or none (lowercase). none needs COOKIE_SECURE=true.
COOKIE_SAMESITE="lax"
# false lets the CSRF cookie travel over plain http, so the login form works
# locally. Production (HTTPS): true.
COOKIE_SECURE=false
